diff --git a/constants/schedule/dateControlScope.ts b/constants/schedule/dateControlScope.ts
new file mode 100644
index 000000000..ae4b90e56
--- /dev/null
+++ b/constants/schedule/dateControlScope.ts
@@ -0,0 +1,31 @@
+import { SCHEDULE_CALENDAR_WEEKLY, type ScheduleKindType } from '~/composables/components/organisms/Schedule/ScheduleHeader/UseScheduleTab'
+import { isWhiteBoardTypeDaily } from '~/store/schedule/schedule_view'
+
+export const DATE_CONTROL_SCOPE_MONTHLY = 'monthly' as const
+export const DATE_CONTROL_SCOPE_WEEKLY = 'weekly' as const
+export const DATE_CONTROL_SCOPE_DAILY = 'daily' as const
+
+export type DateControlScope
+  = | typeof DATE_CONTROL_SCOPE_MONTHLY
+    | typeof DATE_CONTROL_SCOPE_WEEKLY
+    | typeof DATE_CONTROL_SCOPE_DAILY
+
+// ScheduleKindType を DateControl（ヘッダー日付カルーセル）の scope へ解決する唯一の変換ロジック。
+// カレンダー・稼働表・ホワイトボード（分割/連結/日）の 4 ページで DateControl を共有描画するため、
+// ScheduleFilter.vue（PC）・ScheduleHeader/index.vue（SP）の 2 箇所で同一の分岐を重複させない。
+// 手配表・手配地図は DateControl 自体を描画しない非対象 kind のため null を返す。
+export const resolveDateControlScope = (
+  type: ScheduleKindType,
+): DateControlScope | null => {
+  switch (type.kind) {
+    case 'calendar':
+      return type.scope === SCHEDULE_CALENDAR_WEEKLY ? DATE_CONTROL_SCOPE_WEEKLY : DATE_CONTROL_SCOPE_MONTHLY
+    case 'shift_board':
+      return DATE_CONTROL_SCOPE_MONTHLY
+    case 'white_board':
+      return isWhiteBoardTypeDaily(type.scope) ? DATE_CONTROL_SCOPE_DAILY : DATE_CONTROL_SCOPE_MONTHLY
+    case 'assign_board_weekly':
+    case 'dispatch':
+      return null
+  }
+}
