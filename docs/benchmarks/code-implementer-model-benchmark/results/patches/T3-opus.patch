diff --git a/constants/schedule/dateControlScope.ts b/constants/schedule/dateControlScope.ts
new file mode 100644
index 000000000..c3e353bc3
--- /dev/null
+++ b/constants/schedule/dateControlScope.ts
@@ -0,0 +1,106 @@
+import { addDays, addMonths, addWeeks, isSameWeek } from 'date-fns'
+
+import type { ScheduleKindType } from '~/composables/components/organisms/Schedule/ScheduleHeader/UseScheduleTab'
+import {
+  WHITE_BOARD_TYPE_DAILY,
+  WHITE_BOARD_TYPE_MONTHLY,
+  WHITE_BOARD_TYPE_MONTHLY_LINKED,
+} from '~/store/schedule/schedule_view'
+import { fastIsSameDay, fastIsSameMonth } from '~/utils/date/fastDateCompare'
+
+export const DATE_CONTROL_SCOPE_MONTHLY = 'monthly'
+export const DATE_CONTROL_SCOPE_WEEKLY = 'weekly'
+export const DATE_CONTROL_SCOPE_DAILY = 'daily'
+
+// ヘッダー日付カルーセル（DateControl）が前後ボタン・now ボタン・日付テキストで扱う期間の単位。
+export type DateControlScope
+  = | typeof DATE_CONTROL_SCOPE_MONTHLY
+    | typeof DATE_CONTROL_SCOPE_WEEKLY
+    | typeof DATE_CONTROL_SCOPE_DAILY
+
+// scope ごとに変わる日付カルーセルの表示文言と日付演算のまとまり。
+export type DateControlBehavior = {
+  calendarType: 'month' | 'date'
+  nowButtonText: string
+  dateTextFormat: string
+  // 表示中の期間と同じ期間かどうかを判定する。同一期間なら日付を更新せず再取得も走らせない。
+  getIsSamePeriod: (params: { base: Date, target: Date }) => boolean
+  // 前後ボタンで表示期間を amount 個ぶん移動した日付を返す。
+  shiftPeriod: (params: { base: Date, amount: number }) => Date
+}
+
+/**
+ * scope ごとの差分を集約した対応表。
+ *
+ * Record のキーが不足するとコンパイルエラーになるため、DateControlScope のメンバー追加時に更新漏れを
+ * 検知できる。日付テキストは PC / SP 共通の書式とする（画面幅による出し分けはしない）。
+ *
+ * 各エントリは共有される定数のため、参照元での書き換えが全画面へ波及しないよう Readonly で固定する。
+ */
+export const DATE_CONTROL_BEHAVIORS: Readonly<Record<DateControlScope, Readonly<DateControlBehavior>>> = {
+  [DATE_CONTROL_SCOPE_MONTHLY]: {
+    calendarType: 'month',
+    nowButtonText: '今月',
+    dateTextFormat: 'yyyy年MM月',
+    getIsSamePeriod: ({ base, target }) => fastIsSameMonth(base, target),
+    shiftPeriod: ({ base, amount }) => addMonths(base, amount),
+  },
+  [DATE_CONTROL_SCOPE_WEEKLY]: {
+    calendarType: 'date',
+    nowButtonText: '今週',
+    dateTextFormat: 'yyyy年MM月',
+    getIsSamePeriod: ({ base, target }) => isSameWeek(base, target),
+    shiftPeriod: ({ base, amount }) => addWeeks(base, amount),
+  },
+  [DATE_CONTROL_SCOPE_DAILY]: {
+    calendarType: 'date',
+    nowButtonText: '今日',
+    dateTextFormat: 'yyyy年MM月dd日',
+    getIsSamePeriod: ({ base, target }) => fastIsSameDay(base, target),
+    shiftPeriod: ({ base, amount }) => addDays(base, amount),
+  },
+}
+
+type CalendarScope = Extract<ScheduleKindType, { kind: 'calendar' }>['scope']
+type WhiteBoardScope = Extract<ScheduleKindType, { kind: 'white_board' }>['scope']
+
+// scope 軸の対応表。Record のキーが不足するとコンパイルエラーになるため、scope のメンバー追加時に
+// 更新漏れを検知できる。resolveDateControlScope からのみ参照する内部定数のため export しない。
+const CALENDAR_SCOPE_TO_DATE_CONTROL_SCOPE: Record<CalendarScope, DateControlScope> = {
+  monthly: DATE_CONTROL_SCOPE_MONTHLY,
+  weekly: DATE_CONTROL_SCOPE_WEEKLY,
+}
+
+// ホワイトボードの分割・連結は開始日から一定日数を表示するため、月単位で表示期間を移動する。
+const WHITE_BOARD_SCOPE_TO_DATE_CONTROL_SCOPE: Record<WhiteBoardScope, DateControlScope> = {
+  [WHITE_BOARD_TYPE_MONTHLY]: DATE_CONTROL_SCOPE_MONTHLY,
+  [WHITE_BOARD_TYPE_MONTHLY_LINKED]: DATE_CONTROL_SCOPE_MONTHLY,
+  [WHITE_BOARD_TYPE_DAILY]: DATE_CONTROL_SCOPE_DAILY,
+}
+
+/**
+ * ページ種別から日付カルーセルのスコープを解決する。日付カルーセルを持たないページでは `null` を返す。
+ *
+ * 表示可否（`v-if`）とスコープ（`:scope`）の両方をこの 1 関数から導出する。PC 版（ScheduleFilter.vue）と
+ * SP 版（ScheduleHeader/index.vue）で条件を個別に書くと、ページ追加時に片方だけ更新されて表示・非表示が
+ * 食い違うため、判定元を単一化している。
+ *
+ * 手配表（assign_board_weekly）は専用の FilterSection.vue、手配地図（dispatch）は専用の MapQuery.vue が
+ * 日付操作 UI を持つため、このカルーセルの非対象ページとして `null` を返す。
+ *
+ * switch は kind を網羅する（kind 追加時は noImplicitReturns で検知される）。
+ */
+export const resolveDateControlScope = (type: ScheduleKindType): DateControlScope | null => {
+  switch (type.kind) {
+    case 'calendar':
+      return CALENDAR_SCOPE_TO_DATE_CONTROL_SCOPE[type.scope]
+    case 'white_board':
+      return WHITE_BOARD_SCOPE_TO_DATE_CONTROL_SCOPE[type.scope]
+    case 'shift_board':
+      // 稼働表は 1 か月分を表示する（scope を持たないため月固定）
+      return DATE_CONTROL_SCOPE_MONTHLY
+    case 'assign_board_weekly':
+    case 'dispatch':
+      return null
+  }
+}
