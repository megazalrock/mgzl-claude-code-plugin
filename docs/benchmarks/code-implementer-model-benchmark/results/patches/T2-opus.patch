+  --shift-board-schedule-cards-gap: 2px;
+  --shift-board-schedule-cards-padding: 2px;
+
+  display: flex;
+  flex-direction: column;
+  gap: var(--shift-board-schedule-cards-gap);
+  align-items: center;
+  justify-content: center;
+  padding: var(--shift-board-schedule-cards-padding);
+  // --shift-board-schedule-cards-count はカード枚数としてインラインスタイルで与えられる
+  min-height: calc(
+    var(--shift-board-schedule-card-height) * var(--shift-board-schedule-cards-count)
+    + var(--shift-board-schedule-cards-gap) * (var(--shift-board-schedule-cards-count) - 1)
+    + var(--shift-board-schedule-cards-padding) * 2
+  );
+}
+</style>
