 import type { ShiftBoardCell } from '~/types/Schedule/ShiftBoard'
+import { Type } from '~/utils/Type'
 
 type Props = {
   scheduleIds: Readonly<ShiftBoardCell['scheduleIds']>
 }
 
 defineProps<Props>()
+
+const { observe, unobserve } = useShiftBoardCellVisibilityStore()
+
+// IntersectionObserver の初回通知が届くまではカードを描画する。初期値を false にすると通知が
+// 届かない環境で全セルが空になるため、「画面外と判明したらアンマウントする」向きに倒している
+const isVisible = ref<boolean>(true)
+
+// 監視中の要素。監視の解除に監視開始時と同一の要素が必要なため、ref 解決のたびに再評価せず保持する
+let observedElement: HTMLElement | null = null
+
+const handleVisibilityChange = (value: boolean): void => {
+  isVisible.value = value
+}
+
+/**
+ * 監視対象の要素を差し替える
+ *
+ * 空セルではルート要素自体が描画されず、scheduleIds の増減で要素が生成・破棄されるため、
+ * onMounted / onUnmounted ではなく関数 ref で追随する（要素の破棄時は null で呼ばれる）
+ */
+const handleContainerRef = (element: Element | ComponentPublicInstance | null): void => {
+  const nextElement = Type.isHtmlElement(element) ? element : null
+  // 関数 ref は再描画のたびに呼ばれるため、同じ要素に対する監視の解除・再開を避ける
+  if (nextElement === observedElement) {
+    return
+  }
+  if (!Type.isNull(observedElement)) {
+    unobserve(observedElement)
+  }
+  observedElement = nextElement
+  if (!Type.isNull(nextElement)) {
+    observe({ element: nextElement, onVisibilityChange: handleVisibilityChange })
+  }
+}
 </script>
