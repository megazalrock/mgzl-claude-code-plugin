diff --git a/composables/stores/schedules/shift_board/useShiftBoardCellVisibilityStore.ts b/composables/stores/schedules/shift_board/useShiftBoardCellVisibilityStore.ts
new file mode 100644
index 000000000..e6648bcb4
--- /dev/null
+++ b/composables/stores/schedules/shift_board/useShiftBoardCellVisibilityStore.ts
@@ -0,0 +1,103 @@
+import { defineScopedStore } from '~/composables/shared/store/defineScopedStore'
+
+type OnVisibilityChange = (isVisible: boolean) => void
+
+type ObserveArgs = {
+  element: Element
+  onVisibilityChange: OnVisibilityChange
+}
+
+type SetupArgs = {
+  /**
+   * 監視の基準（IntersectionObserver の root）となるスクロールコンテナを返す
+   *
+   * スクロールコンテナはテンプレート ref であり provide 時点では未解決のため、要素そのものではなく
+   * getter を受け取り、ref が解決済みとなる onMounted で解決する
+   */
+  getScrollContainer: () => Element | null
+}
+
+const SHIFT_BOARD_CELL_VISIBILITY_STORE_KEY = 'shiftBoardCellVisibilityStore'
+
+/**
+ * 表示領域の外側に確保する先読み距離
+ *
+ * 表示領域に入る前にカードを描画しておくことで、境界付近のスクロールで mount/unmount を往復するのを防ぐ
+ */
+const ROOT_MARGIN = '200px'
+
+/**
+ * 描画済み（レイアウトを持つ）要素についての通知かどうかを返す
+ *
+ * ローディング中に `display: none` となった要素は rect が 0 の非交差として通知される。これは
+ * 「画面外」ではなく「非表示」の状態であり、画面外と同じ扱いにすると再表示の直後にカードが
+ * 欠けた状態になるため、この通知は無視して直前の表示状態を維持する
+ */
+const getIsRendered = (entry: IntersectionObserverEntry): boolean => {
+  return entry.boundingClientRect.width > 0 || entry.boundingClientRect.height > 0
+}
+
+/**
+ * 稼働表のセルが表示領域内にあるかを監視するストア
+ *
+ * - セルごとに IntersectionObserver を生成すると数が膨大になるため、テーブル全体で 1 つの Observer を共有する
+ * - root にはスクロールコンテナを使う。ビューポートを root にすると、スクロールコンテナに切り取られた要素は
+ *   {@link ROOT_MARGIN} を広げても交差扱いにならず先読みが効かないため
+ * - 汎用の `useIntersectionObserverStore` は root/rootMargin を指定できず、稼働表が必要とする先読みを
+ *   実現できないため、稼働表専用の Observer として持つ
+ */
+export const {
+  useStore: useShiftBoardCellVisibilityStore,
+  provideStore: provideShiftBoardCellVisibilityStore,
+} = defineScopedStore(SHIFT_BOARD_CELL_VISIBILITY_STORE_KEY, ({ getScrollContainer }: SetupArgs) => {
+  const onVisibilityChangeByElement = new Map<Element, OnVisibilityChange>()
+  let observer: IntersectionObserver | null = null
+
+  const handleEntries = (entries: IntersectionObserverEntry[]): void => {
+    entries.forEach((entry) => {
+      if (!getIsRendered(entry)) {
+        return
+      }
+      onVisibilityChangeByElement.get(entry.target)?.(entry.isIntersecting)
+    })
+  }
+
+  /**
+   * 要素の監視を開始する。表示状態が変わるたびに {@link ObserveArgs.onVisibilityChange} が呼ばれる
+   *
+   * Observer 生成前（mount 前）に呼ばれた要素は onMounted でまとめて監視を開始する
+   */
+  const observe = ({ element, onVisibilityChange }: ObserveArgs): void => {
+    onVisibilityChangeByElement.set(element, onVisibilityChange)
+    observer?.observe(element)
+  }
+
+  /** 要素の監視を終了する */
+  const unobserve = (element: Element): void => {
+    onVisibilityChangeByElement.delete(element)
+    observer?.unobserve(element)
+  }
+
+  // root となるスクロールコンテナのテンプレート ref は、mount 前に呼ばれる関数 ref の時点では
+  // まだ解決されていないため、ref が確定する onMounted で Observer を生成する
+  onMounted(() => {
+    const createdObserver = new IntersectionObserver(handleEntries, {
+      root: getScrollContainer(),
+      rootMargin: ROOT_MARGIN,
+    })
+    observer = createdObserver
+    onVisibilityChangeByElement.forEach((_onVisibilityChange, element) => {
+      createdObserver.observe(element)
+    })
+  })
+
+  onScopeDispose(() => {
+    observer?.disconnect()
+    onVisibilityChangeByElement.clear()
+  })
+
+  return {
+    observe,
+    unobserve,
+  }
+})
