+      // Arrange & Act
+      const wrapper = mountScheduleHeader({
+        type: makeWhiteBoardType({ scope: WHITE_BOARD_TYPE_DAILY }),
+        date: FIXED_DATE,
+        breakpoint: { sp: true },
+      })
+
+      // Assert
+      expect(wrapper.findComponent(DateControlStub).props('scope')).toBe('daily')
+    })
+  })
+})
