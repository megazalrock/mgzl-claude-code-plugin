+const ScheduleHeaderContentStub = defineComponent({
+  name: 'ScheduleHeaderContent',
+  props: {
+    type: { type: Object as PropType<ScheduleKindType>, required: true },
+  },
+  template: '<div />',
+})
+
+const SelectedScheduleStub = defineComponent({
+  name: 'SelectedSchedule',
+  props: {
+    type: { type: Object as PropType<ScheduleKindType>, required: true },
+  },
+  template: '<div />',
+})
+
+const FilterModalStub = defineComponent({
+  name: 'FilterModal',
+  props: {
+    type: { type: Object as PropType<ScheduleKindType>, required: true },
