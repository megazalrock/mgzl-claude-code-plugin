+    it.each<{ label: string, type: ScheduleKindType, expected: 'monthly' | 'weekly' | 'daily' }>([
+      { label: 'カレンダー（月）', type: makeCalendarType({ scope: 'monthly' }), expected: 'monthly' },
+      { label: 'カレンダー（週）', type: makeCalendarType({ scope: 'weekly' }), expected: 'weekly' },
+      { label: 'ホワイトボード（分割）', type: makeWhiteBoardType({ scope: WHITE_BOARD_TYPE_MONTHLY }), expected: 'monthly' },
+      { label: 'ホワイトボード（連結）', type: makeWhiteBoardType({ scope: WHITE_BOARD_TYPE_MONTHLY_LINKED }), expected: 'monthly' },
+      { label: 'ホワイトボード（日）', type: makeWhiteBoardType({ scope: WHITE_BOARD_TYPE_DAILY }), expected: 'daily' },
