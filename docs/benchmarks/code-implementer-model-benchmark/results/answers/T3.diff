+const createQueryStoreStub = (): Pick<SchedulesQueryStore, 'hasAnyFilters'> => ({
+  hasAnyFilters: computed(() => false),
+})
+
+const BaseHeaderStub = defineComponent({
+  name: 'BaseHeader',
