diff --git a/components/organisms/Schedule/ShiftBoard/ShiftBoardTable/__tests__/ShiftBoardScheduleCards.test.ts b/components/organisms/Schedule/ShiftBoard/ShiftBoardTable/__tests__/ShiftBoardScheduleCards.test.ts
