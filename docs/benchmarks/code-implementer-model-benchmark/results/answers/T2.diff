+import { OBSERVING_ITEM_DATA_SET_KEY, useIntersectionObserverScopedStore } from '~/composables/stores/UseIntersectionObserverStore'
 import type { ShiftBoardCell } from '~/types/Schedule/ShiftBoard'
+import { Type } from '~/utils/Type'
