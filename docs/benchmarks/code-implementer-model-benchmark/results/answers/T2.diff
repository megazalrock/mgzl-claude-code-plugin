 }
 
-defineProps<Props>()
+const props = defineProps<Props>()
+
+const { observe, unobserve } = useIntersectionObserverScopedStore()
+
+const shiftBoardScheduleCardsRef = ref<HTMLElement | null>(null)
+
+const isGhost = ref<boolean>(false)
+const cachedHeight = ref<number | null>(null)
+
+const ghostStyle = computed(() => {
+  if (!isGhost.value || Type.isNull(cachedHeight.value)) {
+    return {}
+  }
+  return {
+    '--cached-height': `${cachedHeight.value}px`,
+  }
+})
+
+const intersectionObserverData = computed(() => {
+  if (Type.isUndefined(props.cellKey)) {
