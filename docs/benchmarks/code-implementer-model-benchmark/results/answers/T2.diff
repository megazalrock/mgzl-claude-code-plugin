+    // 発火するが、画面外に出たわけではないため無視する（display:none 中は height が 0 になる）
+    if (!isIntersecting && boundingClientRect.height === 0) {
+      return
+    }
+    isGhost.value = !isIntersecting
+    if (!isIntersecting) {
+      // isGhost = true になると v-if="!isGhost" で slot が破棄され実高さが測れなくなるため、
+      // 破棄される直前のこのタイミングで実高さを確保しておく
+      cachedHeight.value = boundingClientRect.height
+    }
+  })
+  observing = { id, element }
+}
+
+// scheduleIds の空→非空で v-if の要素が後から生成されるセルがあるため、
+// onMounted ではなく template ref の watch で要素の出現・消滅に追従して観測を付け替える
+watch([shiftBoardScheduleCardsRef, () => props.cellKey], ([element, id]) => {
+  stopObserving()
