+    [OBSERVING_ITEM_DATA_SET_KEY]: props.cellKey,
+  }
+})
+
+// 解除には observe 時と同じ id・要素の組が必要だが、unmount 時の onUnmounted では
+// template ref が既に null に戻っているため、観測中の組をここに保持する
+let observing: { id: string, element: HTMLElement } | null = null
+
+const stopObserving = () => {
+  if (Type.isNull(observing)) {
+    return
+  }
+  unobserve(observing.id, observing.element)
+  observing = null
+}
+
+const startObserving = ({ id, element }: { id: string, element: HTMLElement }) => {
+  observe(id, element, ({ isIntersecting, boundingClientRect }) => {
