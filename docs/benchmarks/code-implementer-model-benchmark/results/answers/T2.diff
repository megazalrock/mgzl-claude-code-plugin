index 000000000..ff45e4f5d
--- /dev/null
+++ b/components/organisms/Schedule/ShiftBoard/ShiftBoardTable/__tests__/ShiftBoardScheduleCards.test.ts
@@ -0,0 +1,271 @@
+import { mount } from '@vue/test-utils'
+import { h, nextTick } from 'vue'
+
+import { makeTestId, makeTestIdStartsWith } from '~/__utils__/makeTestId'
+import { type IntersectionObserverStore, OBSERVING_ITEM_DATA_SET_KEY } from '~/composables/stores/UseIntersectionObserverStore'
+import { Type } from '~/utils/Type'
+
+import { TEST_ID } from '../ShiftBoardScheduleCards.testIds'
+import ShiftBoardScheduleCards from '../ShiftBoardScheduleCards.vue'
+
+// useIntersectionObserverScopedStore が inject する injection key は defineScopedStore 内部の
+// ローカル変数（非公開 Symbol）であり、テストコードから provide して差し替えることができない。
+// そのため vi.mock でモジュールごと差し替える（差し替え範囲は下記 vi.mock 内コメント参照）
+const { observeMock, unobserveMock } = vi.hoisted(() => {
+  return {
+    observeMock: vi.fn<IntersectionObserverStore['observe']>(),
+    unobserveMock: vi.fn<IntersectionObserverStore['unobserve']>(),
+  }
+})
+
+// モジュールの他 export（OBSERVING_ITEM_DATA_SET_KEY 等）は ...actual で本物を維持しつつ、
+// useIntersectionObserverScopedStore の戻り値だけを observe / unobserve のモックに差し替える
+vi.mock('~/composables/stores/UseIntersectionObserverStore', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('~/composables/stores/UseIntersectionObserverStore')>()
+  return {
+    ...actual,
+    useIntersectionObserverScopedStore: () => ({
+      observe: observeMock,
+      unobserve: unobserveMock,
+    }),
+  }
+})
+
+type Props = InstanceType<typeof ShiftBoardScheduleCards>['$props']
+
+const SLOT_ITEM_TEST_ID_PREFIX = 'slot-item-'
+const OBSERVER_ID = 'observer-1'
+const NEW_OBSERVER_ID = 'observer-2'
+const SCHEDULE_ID = 100
+
+const createWrapper = (props: Partial<Props> = {}) => {
+  return mount(ShiftBoardScheduleCards, {
+    props: {
+      scheduleIds: [],
+      ...props,
+    },
+    slots: {
+      default: ({ scheduleId }: { scheduleId: number }) => h('div', { 'data-testid': `${SLOT_ITEM_TEST_ID_PREFIX}${scheduleId}` }),
+    },
+  })
+}
+
+// scheduleIds と cellKey を指定してマウントし、template ref の watch（flush: 'post'）による
+// observe 登録が完了するまで待つ
+const mountObserved = async (props: Partial<Props> = {}): Promise<ReturnType<typeof createWrapper>> => {
+  const wrapper = createWrapper({
+    scheduleIds: [SCHEDULE_ID],
+    cellKey: OBSERVER_ID,
+    ...props,
+  })
+  await nextTick()
+  return wrapper
+}
+
+// observe に登録された最新のコールバックを isIntersecting/height で発火し、post-flush の再描画を待つ
+const fireObserveCallback = async ({ isIntersecting, height }: { isIntersecting: boolean, height: number }): Promise<void> => {
+  const callback = observeMock.mock.calls.at(-1)?.[2]
+  if (Type.isUndefined(callback)) {
+    throw new Error('observe callback was not registered')
+  }
+  // SUT の startObserving コールバックが参照するのは isIntersecting と boundingClientRect.height のみのため、
+  // IntersectionObserverEntry の他プロパティは省略した最小実装で代替する
+  callback({ isIntersecting, boundingClientRect: { height } } as IntersectionObserverEntry)
+  await nextTick()
+}
+
+const getCardsElement = (wrapper: ReturnType<typeof createWrapper>): HTMLElement => wrapper.get<HTMLElement>(makeTestId(TEST_ID.CARDS)).element
+
+describe('ShiftBoardScheduleCards.vue', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+  })
+
+  describe('描画', () => {
+    it('scheduleIds が空の場合、root 要素が描画されない', () => {
+      // Arrange & Act
+      const wrapper = createWrapper({ scheduleIds: [] })
+
+      // Assert
+      expect(wrapper.find(makeTestId(TEST_ID.CARDS)).exists()).toBe(false)
+    })
+
+    it('scheduleIds が複数件の場合、id ごとに slot が描画される', () => {
+      // Arrange & Act
+      const wrapper = createWrapper({ scheduleIds: [100, 200] })
+
+      // Assert
+      const slotTestIds = wrapper
+        .findAll(makeTestIdStartsWith(SLOT_ITEM_TEST_ID_PREFIX))
+        .map(slotItem => slotItem.attributes('data-testid'))
+      expect(slotTestIds).toStrictEqual(['slot-item-100', 'slot-item-200'])
+    })
+  })
+
+  describe('cellKey', () => {
+    it('未指定の場合、observing 属性が付与されず observe も呼ばれない', async () => {
+      // Arrange & Act
+      const wrapper = createWrapper({ scheduleIds: [SCHEDULE_ID] })
+      await nextTick()
+
+      // Assert
+      expect(wrapper.attributes(OBSERVING_ITEM_DATA_SET_KEY)).toBeUndefined()
+      expect(observeMock).not.toHaveBeenCalled()
+    })
+
+    it('指定した場合、observing 属性が付与され observe がルート要素で 1 回呼ばれる', async () => {
+      // Arrange & Act
+      const wrapper = await mountObserved()
+
+      // Assert
+      expect(wrapper.attributes(OBSERVING_ITEM_DATA_SET_KEY)).toBe(OBSERVER_ID)
+      expect(observeMock).toHaveBeenCalledTimes(1)
+      expect(observeMock).toHaveBeenCalledWith(OBSERVER_ID, getCardsElement(wrapper), expect.any(Function))
+      expect(unobserveMock).not.toHaveBeenCalled()
+    })
+  })
+
+  describe('observe コールバック発火時の ghost 化', () => {
+    it('isIntersecting:false かつ height>0 で発火すると、slot が非表示になり root は残存し --cached-height が設定される', async () => {
+      // Arrange
+      const wrapper = await mountObserved()
+
+      // Act
+      await fireObserveCallback({ isIntersecting: false, height: 120 })
+
+      // Assert
+      expect(wrapper.findAll(makeTestIdStartsWith(SLOT_ITEM_TEST_ID_PREFIX))).toHaveLength(0)
+      expect(wrapper.find(makeTestId(TEST_ID.CARDS)).exists()).toBe(true)
+      expect(getCardsElement(wrapper).style.getPropertyValue('--cached-height')).toBe('120px')
+    })
+
+    it('ghost 化後に isIntersecting:true で発火すると、slot が復帰し --cached-height が解除される', async () => {
+      // Arrange
+      const wrapper = await mountObserved()
+      await fireObserveCallback({ isIntersecting: false, height: 120 })
+
+      // Act
+      // isIntersecting:true 復帰時は height を参照しないため、height の値はアサーション対象外の任意値
+      await fireObserveCallback({ isIntersecting: true, height: 0 })
+
+      // Assert
+      expect(wrapper.findAll(makeTestIdStartsWith(SLOT_ITEM_TEST_ID_PREFIX))).toHaveLength(1)
+      expect(getCardsElement(wrapper).style.getPropertyValue('--cached-height')).toBe('')
+    })
+
+    it('isIntersecting:false かつ height===0 で発火しても無視され、slot が維持される', async () => {
+      // Arrange
+      const wrapper = await mountObserved()
+
+      // Act
+      await fireObserveCallback({ isIntersecting: false, height: 0 })
+
+      // Assert
+      expect(wrapper.findAll(makeTestIdStartsWith(SLOT_ITEM_TEST_ID_PREFIX))).toHaveLength(1)
+      expect(getCardsElement(wrapper).style.getPropertyValue('--cached-height')).toBe('')
+    })
+
+    it('ghost 中に isIntersecting:false かつ height===0 で発火しても無視され、--cached-height が 0px に汚染されない', async () => {
+      // Arrange
+      const wrapper = await mountObserved()
+      await fireObserveCallback({ isIntersecting: false, height: 120 })
+
+      // Act
+      await fireObserveCallback({ isIntersecting: false, height: 0 })
+
+      // Assert
+      expect(wrapper.findAll(makeTestIdStartsWith(SLOT_ITEM_TEST_ID_PREFIX))).toHaveLength(0)
+      expect(getCardsElement(wrapper).style.getPropertyValue('--cached-height')).toBe('120px')
+    })
+
+    it('復帰後に異なる高さで再度 ghost 化すると、--cached-height が新しい高さに更新される', async () => {
+      // Arrange
+      const wrapper = await mountObserved()
+      await fireObserveCallback({ isIntersecting: false, height: 120 })
+      await fireObserveCallback({ isIntersecting: true, height: 0 })
+
+      // Act
+      await fireObserveCallback({ isIntersecting: false, height: 200 })
+
+      // Assert
+      expect(wrapper.findAll(makeTestIdStartsWith(SLOT_ITEM_TEST_ID_PREFIX))).toHaveLength(0)
+      expect(getCardsElement(wrapper).style.getPropertyValue('--cached-height')).toBe('200px')
+    })
+  })
+
+  describe('観測の付け替え / unmount', () => {
+    it('scheduleIds が非空から空になると、observe 時と同一の要素で unobserve が呼ばれ、再 observe はされない', async () => {
+      // Arrange
+      const wrapper = await mountObserved()
+      const initialElement = getCardsElement(wrapper)
+
+      // Act
+      await wrapper.setProps({ scheduleIds: [] })
+
+      // Assert
+      expect(unobserveMock).toHaveBeenCalledTimes(1)
+      expect(unobserveMock).toHaveBeenCalledWith(OBSERVER_ID, initialElement)
+      expect(observeMock).toHaveBeenCalledTimes(1)
+    })
+
+    it('scheduleIds が空から非空に戻ると、新しい root 要素で observe が再登録される', async () => {
+      // Arrange
+      const wrapper = await mountObserved()
+      const initialElement = getCardsElement(wrapper)
+      await wrapper.setProps({ scheduleIds: [] })
+
+      // Act
+      await wrapper.setProps({ scheduleIds: [SCHEDULE_ID] })
+
+      // Assert
+      expect(observeMock).toHaveBeenCalledTimes(2)
+      const secondObservedElement = observeMock.mock.calls[1]?.[1]
+      if (Type.isUndefined(secondObservedElement)) {
+        throw new Error('2 回目の observe 呼び出しが登録されていません')
+      }
+      expect(secondObservedElement).not.toBe(initialElement)
+    })
+
+    it('ghost 化した状態で scheduleIds が空→非空に戻ると、ghost 状態と --cached-height がリセットされる', async () => {
+      // Arrange
+      const wrapper = await mountObserved()
+      await fireObserveCallback({ isIntersecting: false, height: 120 })
+      await wrapper.setProps({ scheduleIds: [] })
+
+      // Act
+      await wrapper.setProps({ scheduleIds: [SCHEDULE_ID] })
+
+      // Assert: stale な ghost 状態が持ち越されず、slot が復帰し --cached-height も解除される
+      expect(wrapper.findAll(makeTestIdStartsWith(SLOT_ITEM_TEST_ID_PREFIX))).toHaveLength(1)
+      expect(getCardsElement(wrapper).style.getPropertyValue('--cached-height')).toBe('')
+    })
+
+    it('cellKey が別の値に変わると、旧 id で unobserve され新 id で同一要素に再 observe される', async () => {
+      // Arrange
+      const wrapper = await mountObserved()
+      const element = getCardsElement(wrapper)
+
+      // Act
+      await wrapper.setProps({ cellKey: NEW_OBSERVER_ID })
+
+      // Assert
+      expect(unobserveMock).toHaveBeenCalledTimes(1)
+      expect(unobserveMock).toHaveBeenCalledWith(OBSERVER_ID, element)
