+    // これにより、再度非空になった際に古い高さの空箱が IntersectionObserver の初回コールバックまで
+    // 持ち越されるのを防ぐ
+    isGhost.value = false
+    cachedHeight.value = null
+    return
+  }
+  if (!Type.isUndefined(id) && Type.isHtmlElement(element)) {
+    startObserving({ id, element })
+  }
+}, { flush: 'post' })
+
+onBeforeUnmount(() => {
+  // onUnmounted では template ref が既に null に戻り解除漏れになるため onBeforeUnmount で解除する
+  stopObserving()
+})
 </script>
+
+<style lang="scss" scoped>
+.shift-board-schedule-cards {
+  height: var(--cached-height, initial);
+}
